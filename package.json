{
  "name": "jesterlib",
  "version": "0.0.1",
  "description": "A from-scratch TypeScript implementation of the WhatsApp Web (multi-device) protocol: Noise handshake, WABinary, protobuf and QR pairing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./binary": "./dist/binary/index.js",
    "./proto": "./dist/proto/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types \"test/**/*.test.ts\"",
    "vendor:tokens": "node scripts/vendor-tokens.mjs",
    "example:connect": "node --experimental-strip-types examples/connect.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "protocol",
    "noise-protocol",
    "multi-device",
    "reverse-engineering",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "baileys": "^7.0.0-rc14",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.9.0"
  },
  "author": "Arthur Barbosa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurbarbosadev/JesterLib.git"
  },
  "bugs": {
    "url": "https://github.com/arthurbarbosadev/JesterLib/issues"
  },
  "homepage": "https://github.com/arthurbarbosadev/JesterLib#readme"
}
